{
  "expo": {
    "name": "fanstamp",
    "slug": "fanstamp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seventhstreet378.fanstamp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyCQPsXimsCknE1AjLf_eW11Vb53xeSE2Cs"
      }
    },
    "android": {
      "package": "com.seventhstreet378.fanstamp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "FanStamp uses your photo library to attach photos to events."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#1a1a2e"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b301f918-3a10-4e66-a1ab-9d2f994a2a6f"
      }
    },
    "owner": "seventhstreet378"
  }
}
