// FanStamp Firestore security rules — Tier 1 social features.
//
// This file is NOT deployed automatically: there's no firebase.json/CLI in
// this repo (see the comment in firebaseConfig.js), so paste the relevant
// `match` blocks into the Firebase console under Firestore Database → Rules,
// alongside whatever already governs users/{uid}/events, bucketList, etc.
//
// Search (utils/socialSync.js's searchUsers) runs a collectionGroup('profile')
// query ranged/filtered on displayName_lower and email_lower — Firestore
// needs a collection-group index for each. These aren't created by this
// file either; the first time each query runs, the SDK error includes a
// direct "create index" link for the console.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile doc: readable per the `privacy` field, writable only
    // by its owner. 'friends' visibility means "anyone in my followers".
    match /users/{uid}/profile/{doc} {
      allow read: if resource.data.privacy == 'public'
        || (request.auth != null && request.auth.uid == uid)
        || (resource.data.privacy == 'friends' && request.auth != null
            && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Who I follow — only I can add/remove entries here.
    match /users/{uid}/following/{targetUid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Who follows me — only the follower themself can add/remove their own
    // entry (this is what lets follow/unfollow write into someone else's
    // followers subcollection without granting them arbitrary write access).
    match /users/{uid}/followers/{followerUid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == followerUid;
    }
  }
}
